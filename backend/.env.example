# Environment
NODE_ENV=development        # 'development' or 'production'

# Server Configuration
PORT=5000                  # Backend server port
FRONTEND_URL=http://localhost:5173

# Database Configuration
DB_HOST=localhost          # Database host
DB_NAME=your_db_name      # Database name
DB_USER=your_db_user      # Database username
DB_PASS=your_db_password  # Database password

# Authentication
JWT_SECRET=your_jwt_secret_key  # Long, random string for JWT signing
JWT_EXPIRES_IN=24h              # Token expiration time
COOKIE_MAX_AGE=86400000        # Cookie expiration in milliseconds (24h)

# Default Admin User
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=strong_password